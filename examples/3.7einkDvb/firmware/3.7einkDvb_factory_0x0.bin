              @dragleave.prevent="draggingFile = false" @drop.prevent="onDrop">
        {{ draggingFile ? 'æ¾å¼€è½½å…¥' : (imageEl ? 'æ›´æ¢å›¾ç‰‡' : 'é€‰æ‹©å›¾ç‰‡ Â· å¯æ‹–å…¥æˆ–ç²˜è´´') }}
      </button>
      <p v-if="imageName" class="img-meta">{{ imageName }} Â· {{ imgW }}Ã—{{ imgH }}</p>
      <p class="hint">è‡ªåŠ¨è£å‰ªä¸ºå±å¹•æ¯”ä¾‹ï¼Œå¯æ‹–åŠ¨é¢„è§ˆè°ƒæ•´å–æ™¯ã€‚</p>

        <div class="mode-note"><strong>å…­è‰²æŠ–åŠ¨</strong><span>é»‘ã€ç™½ã€é»„ã€çº¢ã€è“ã€ç»¿ Â· å…¨å±åˆ·æ–°</span></div>
      <template v-if="imageEl">
        <details class="edit-group" open><summary>å–æ™¯ä¸æ—‹è½¬</summary><div class="group-body">
        <div class="slider">
          <div class="slider-head">
            <span class="field">ç¼©æ”¾</span>
            <span class="slider-val">{{ zoom.toFixed(2) }}Ã—</span>
          </div>
          <input type="range" min="1" max="4" step="0.01" v-model.number="zoom" @input="onCropChange" />
        </div>
        <div class="slider">
          <div class="slider-head">
            <span class="field">æ°´å¹³</span>
            <span class="slider-val">{{ Math.round(panX * 100) }}%</span>
          </div>
          <input type="range" min="0" max="1" step="0.001" v-model.number="panX" @input="onCropChange" />
        </div>
        <div class="slider">
          <div class="slider-head">
            <span class="field">å‚ç›´</span>
            <span class="slider-val">{{ Math.round(panY * 100) }}%</span>
          </div>
          <input type="range" min="0" max="1" step="0.001" v-model.number="panY" @input="onCropChange" />
        </div>
        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px">
          <button class="ghost-btn" type="button" :disabled="busy" @click="rotateImage(-90)">å·¦è½¬90Â°</button>
          <button class="ghost-btn" type="button" :disabled="busy" @click="rotateImage(90)">å³è½¬90Â°</button>
          <span>{{ imageRotation }}Â°</span>
          <button class="ghost-btn" type="button" @click="resetCrop">é‡ç½®å–æ™¯</button>
        </div>

        </div></details>
        <details class="edit-group" open><summary>å…­è‰²æ··è‰²ä¸é£æ ¼</summary><div class="group-body">
        <div class="field">é¢œè‰²</div>
        <div class="quant-row">
          <button type="button" :class="{ active: quant === 'gray' }" @click="setQuant('gray')">ç°åº¦</button>
          <button type="button" :class="{ active: quant === 'color' }" @click="setQuant('color')">å½©è‰²</button>
        </div>

        <div class="field">å›¾åƒé£æ ¼</div>
        <div class="style-grid">
          <button v-for="s in renderStyles" :key="s.id" class="style-card" type="button"
                  :class="{ active: renderStyle === s.id }" @click="setRenderStyle(s.id)">
            <strong>{{ s.name }}</strong><small>{{ s.note }}</small>
          </button>
        </div>

        <div class="field">æ··è‰²ç»†èŠ‚</div>
        <p class="hint">ç”¨å…­ç§å¢¨è‰²çš„ç–å¯†è¡¨ç°æ›´å¤šå±‚æ¬¡ï¼Œå¯å…ˆå¯¹ç…§é¢„è§ˆå†å‘é€ã€‚</p>
        <div class="style-grid">
          <button v-for="m in ditherModes" :key="m.id" class="style-card" type="button"
                  :class="{ active: ditherQuality === m.id }" @click="setDitherQuality(m.id)">
            <strong>{{ m.name }}</strong><small>{{ m.note }}</small>
          </button>
        </div>

        <template v-if="renderStyle !== 'flat'">
          <div class="field">å…­è‰²é™å™ª</div>
          <div class="style-grid">
            <button v-for="m in sixDenoiseModes" :key="m.id" class="style-card" type="button" :disabled="busy"
                    :class="{active:sixDenoise===m.id}" @click="setSixDenoise(m.id)">
              <strong>{{ m.name }}</strong><small>{{ m.note }}</small>
            </button>
          </div>
          <p class="hint">é™å™ªä¼šå¹³æ»‘ç»†ç¢æ‚è‰²ï¼›æŠ–åŠ¨é¢—ç²’ç”¨äºæ··è‰²ï¼Œä»ä¼šä¿ç•™ã€‚</p>
          <details class="noise-compare" @toggle="onNoiseCompareToggle">
            <summary>å±•å¼€é™å™ªæ•ˆæœå¯¹ç…§</summary>
            <div class="style-grid">
              <button v-for="m in sixDenoiseModes" :key="m.id" class="style-card" type="button" :disabled="busy" :class="{active:sixDenoise===m.id}" @click="setSixDenoise(m.id)">
                <strong>{{ m.name }}</strong>
                <img v-if="noisePreviews[m.id]" class="noise-preview" :src="noisePreviews[m.id]" :alt="m.name+'æ•ˆæœé¢„è§ˆ'"/>
                <span v-else class="noise-placeholder">{{ noisePreviewBusy?'æ›´æ–°ä¸­â€¦':'ç­‰å¾…é¢„è§ˆ' }}</span>
              </button>
            </div>
          </details>
        </template>
        </div></details>
        <details class="edit-group"><summary>æ˜æš—ä¸é¢œè‰²</summary><div class="group-body">
        <div class="slider">
          <div class="slider-head">
            <span class="field">æ›å…‰</span>
            <span class="slider-val">{{ exposure > 0 ? '+' : '' }}{{ exposure }}</span>
          </div>
          <input type="range" min="-100" max="100" step="1" v-model.number="exposure" @input="onAdjustChange" />
        </div>
        <div class="slider">
          <div class="slider-head">
            <span class="field">äº®åº¦</span>
            <span class="slider-val">{{ brightness > 0 ? '+' : '' }}{{ brightness }}</span>
          </div>
          <input type="range" min="-100" max="100" step="1" v-model.number="brightness" @input="onAdjustChange" />
        </div>
        <div class="slider">
          <div class="slider-head">
            <span class="field">å¯¹æ¯”åº¦</span>
            <span class="slider-val">{{ contrast > 0 ? '+' : '' }}{{ contrast }}</span>
          </div>
          <input type="range" min="-100" max="100" step="1" v-model.number="contrast" @input="onAdjustChange" />
        </div>
        <div class="slider">
          <div class="slider-head">
            <span class="field">é«˜å…‰</span>
            <span class="slider-val">{{ highlights > 0 ? '+' : '' }}{{ highlights }}</span>
          </div>
          <input type="range" min="-100" max="100" step="1" v-model.number="highlights" @input="onAdjustChange" />
        </div>
        <div class="slider">
          <div class="slider-head">
            <span class="field">é˜´å½±</span>
            <span class="slider-val">{{ shadows > 0 ? '+' : '' }}{{ shadows }}</span>
          </div>
          <input type="range" min="-100" max="100" step="1" v-model.number="shadows" @input="onAdjustChange" />
        </div>
        <div class="slider">
          <div class="slider-head">
            <span class="field">é¥±å’Œåº¦</span>
            <span class="slider-val">{{ saturation > 0 ? '+' : '' }}{{ saturation }}</span>
          </div>
          <input type="range" min="-100" max="100" step="1" v-model.number="saturation" @input="onAdjustChange" />
        </div>
        <div>
          <button class="ghost-btn" type="button" @click="resetAdjust">é‡ç½®è°ƒæ•´</button>
        </div>

        </div></details>
        <details class="edit-group"><summary>åŒºåŸŸæ›¿æ¢ä¸é‡å¤å‘é€</summary><div class="group-body">
        <div class="quant-row">
          <label><input type="checkbox" :checked="regionUpdate" :disabled="!canRegionUpdate" @change="setRegionUpdate($event.target.checked)" />åŒºåŸŸæ›¿æ¢</label>
          <label><input type="checkbox" v-model="forceRefresh" />å¼ºåˆ¶åˆ·æ–°</label>
        </div>
        <div v-if="regionUpdate" class="region-fields">
          <label>X<input type="number" min="0" max="479" step="1" v-model.number="updateRect.x" @input="onCropChange" /></label>
          <label>Y<input type="number" min="0" max="719" step="1" v-model.number="updateRect.y" @input="onCropChange" /></label>
          <label>å®½<input type="number" min="1" :max="panelWidth-updateRect.x" step="1" v-model.number="updateRect.width" @input="onCropChange" /></label>
          <label>é«˜<input type="number" min="1" :max="panelHeight-updateRect.y" step="1" v-model.number="updateRect.height" @input="onCropChange" /></label>
        </div>
        <p class="hint">{{ regionUpdate ? 'ä»…æ›¿æ¢æ¡†å†…å†…å®¹ï¼Œå±å¹•ä»æ‰§è¡Œå®Œæ•´åˆ·æ–°ã€‚' : canRegionUpdate ? 'å¯åœ¨ä¸Šæ¬¡æˆåŠŸå‘é€çš„ç”»é¢ä¸Šæ›¿æ¢æŒ‡å®šåŒºåŸŸã€‚' : 'å®Œæ•´å‘é€ä¸€æ¬¡ç”»é¢åï¼Œå¯å¯ç”¨åŒºåŸŸæ›¿æ¢ã€‚' }}</p>

        </div></details>
      </template>
    </div>

    </section>
    </div>
    <div v-show="tab === 'text' || tab === 'image'" class="actions">
      <button class="primary" type="button" :disabled="busy || (tab === 'image' && !imageEl)" @click="push">
        {{ busyLabel }}
      </button>
      <button class="ghost-btn" v-if="tab === 'image'" type="button" :disabled="busy" @click="clearDisplay">æ¸…ç©ºå±å¹•</button>
      <div class="status" :class="statusClass" role="status" aria-live="polite">{{ status }}</div>
      <div v-if="busy" class="progress" aria-label="å±å¹•æ­£åœ¨åˆ·æ–°"></div>
    </div>

    <div class="foot">
      <span>E6 3.7</span>
      <span>å›¾ç‰‡åœ¨æµè§ˆå™¨ä¸­å¤„ç†</span>
    </div>
    </div>
  </div>

  <script>
    const { createApp, ref, onMounted, computed, nextTick } = Vue;

    const Pipeline = window.EinkPipeline;
    let PANEL_W = Pipeline.WIDTH, PANEL_H = Pipeline.HEIGHT;
    const COLORS = Pipeline.COLORS;
    const cssOf = (id) => COLORS.find(c => c.id === id).css;
    const clamp = (v, a, b) => Math.max(a, Math.min(b, v));

    const fetchJson = async (url, options = {}, timeoutMs = 15000) => {
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), timeoutMs);
      try {
        const res = await fetch(url, { ...options, signal: controller.signal });
        const info = await res.json();
        if (!res.ok || info.ok === false) throw new Error(info.message || `HTTP ${res.status}`);
        return info;
      } finally { clearTimeout(timer); }
    };

    const applyAdjust = (data, { exposure, brightness, contrast, highlights, shadows, saturation }) => {
      const exp = Math.pow(2, exposure / 50);
      const bri = brightness * 1.2;
      const con = (contrast + 100) / 100;
      const sat = (saturation + 100) / 100;
      const hi = highlights / 100;
      const sh = shadows / 100;
      for (let i = 0; i < data.length; i += 4) {
        let r = data[i], g = data[i + 1], b = data[i + 2];
        r *= exp; g *= exp; b *= exp;
        r = (r - 128) * con + 128 + bri;
        g = (g - 128) * con + 128 + bri;
        b = (b - 128) * con + 128 + bri;
        let y = 0.299 * r + 0.587 * g + 0.114 * b;
        if (y > 128 && hi !== 0) {
          const t = (y - 128) / 127;
          const k = 1 - hi * t * 0.85;
          r = 128 + (r - 128) * k;
          g = 128 + (g - 128) * k;
          b = 128 + (b - 128) * k;
          y = 0.299 * r + 0.587 * g + 0.114 * b;
        }
        if (y < 128 && sh !== 0) {
          const t = (128 - y) / 128;
          const lift = sh * t * 55;
          r += lift; g += lift; b += lift;
          y = 0.299 * r + 0.587 * g + 0.114 * b;
        }
        r = y + (r - y) * sat;
        g = y + (g - y) * sat;
        b = y + (b - y) * sat;
        data[i] = clamp(r, 0, 255);
        data[i + 1] = clamp(g, 0, 255);
        data[i + 2] = clamp(b, 0, 255);
      }
    };

    createApp({
      setup() {
        const tab = ref('wifi');
        const wifiMode = ref('ap');
        const wifiSsid = ref('');
        const wifiUrl = ref('http://192.168.4.1');
        const wifiList = ref([]);
        const selectedSsid = ref('');
        const wifiPass = ref('');
        const wifiBusy = ref(false);
        const wifiStatus = ref('');
        const wifiStatusClass = ref('');
        const chargePower = ref('balanced');
        const chargeCapacity = ref(500);
        const chargeDirty = ref(false);
        const chargeReady = ref(false);
        const chargeDetail = ref('æ­£åœ¨è¯»å–å……ç”µé…ç½®');
        const gaugeDetail = ref('');
        const applyChargeInfo = (info, saved = false) => {
          chargePower.value = info.charge;
          if (!chargeDirty.value || saved) chargeCapacity.value = info.capacity_mah;
          if (saved) chargeDirty.value = false;
          chargeReady.value = true;
          chargeDetail.value = info.capacity_mah + 'mAhï¼šç›®æ ‡ ' + info.target_ma + 'mAï¼Œæ’æµè®¾å®š ' + info.icc_ma + 'mAï¼ˆéå®æµ‹ï¼‰';
          gaugeDetail.value = !info.gauge_read_ok ? 'ç”µé‡è®¡è¯»å–å¤±è´¥' : !info.battery_present ? 'æœªæ£€æµ‹åˆ°ç”µæ± ' :
            'ç”µé‡è®¡' + (info.gauge_enabled ? 'å·²å¯ç”¨' : 'æœªå¯ç”¨') + 'ï¼ŒSOC ' + (info.soc >= 0 ? info.soc + '%' : 'æ— æ•ˆ') + 'ï¼›å†…éƒ¨è‡ªåŠ¨å­¦ä¹ ï¼Œæ— å¯è¯»å®Œæˆåº¦ã€‚';
        };
        const chargeBusy = ref(false);
        const chargeStatus = ref('');
        const chargeStatusClass = ref('');
        const chargeLevels = [
          { id: 'slow', label: 'æ¶“æµå……ç”µ', note: '0.2C' },
          { id: 'balanced', label: 'æ­£å¸¸å……ç”µ', note: '0.5C Â· é»˜è®¤æ¡£' },
          { id: 'fast', label: 'å¿«é€Ÿå……ç”µ', note: '1.0C' },
        ];
        const text = ref('ä½ å¥½ï¼ŒEink');
        const bg = ref(0x1);
        const fg = ref(0x0);
        const fontSize = ref(42);
        const busy = ref(false); const panelWidth=ref(PANEL_W), panelHeight=ref(PANEL_H), panelRotation=ref(0);
        const status = ref('');
        const phase = ref('idle');
        const deviceOnline = ref(false);
        const quant = ref('color');
        const lastPanelFrame = ref(null), regionUpdate = ref(false), forceRefresh = ref(false);
        const updateRect = ref({x:0, y:0, width:PANEL_W, height:PANEL_H});
        const canRegionUpdate = computed(() => !!lastPanelFrame.value);
        const ditherQuality = ref('best');
        const ditherModes = [
          { id: 'fast', name: 'è½»åº¦', note: 'è½»åº¦æ‰©æ•£' },
          { id: 'standard', name: 'æ ‡å‡†', note: 'æ ‡å‡†æ‰©æ•£' },
          { id: 'best', name: 'ç²¾ç»†', note: 'å®Œæ•´æ‰©æ•£ Â· ä¿ç•™å±‚æ¬¡' },
        ];
        const previewPixels=ref(false), noisePreviews=ref({}), noisePreviewBusy=ref(false), noiseCompareOpen=ref(false);
        const sixDenoise = ref('balanced');
        const sixDenoiseModes = [
          {id:'off',name:'å…³é—­',note:'ä¿ç•™åŸå§‹å…­è‰²æŠ–åŠ¨'},
          {id:'balanced',name:'æ ‡å‡†é™å™ª',note:'ä¿æŠ¤ç°è‰² Â· å¹³æ»‘ç»†ç¢æ‚ç‚¹'},
          {id:'strong',name:'è¾ƒå¼ºé™å™ª',note:'å‡å°‘æš—éƒ¨æ‚è‰² Â· å¼±è‰²å½©ä¼šå˜æ·¡'},
        ];
        const renderStyle = ref('illustration');
        const renderStyles = [
          { id: 'photo', name: 'æŸ”å’Œç…§ç‰‡', note: 'å¹³æ»‘æ˜æš—' },
          { id: 'illustration', name: 'æ¸…æ™°æ’ç”»', note: 'ä¿ç•™è‰²å½©ç»†èŠ‚' },
          { id: 'flat', name: 'çº¯è‰²å›¾å½¢', note: 'é€‚åˆå›¾æ ‡ä¸æ–‡å­— Â· å…­è‰²ç›´å–' },
        ];
        const imageName = ref('');
        const imageEl = ref(null);
        const imageRotation = ref(0);
        const imgW = ref(0);
        const imgH = ref(0);
        const canvas = ref(null), appearanceCanvas = ref(null);
        const fileInput = ref(null);
        const colors = COLORS;
        const previewBusy = ref(false);
        const usedColors = ref(0);
        const draggingFile = ref(false);

        const zoom = ref(1);
        const panX = ref(0.5);
        const panY = ref(0.5);
        const exposure = ref(0);
        const brightness = ref(0);
        const contrast = ref(0);
        const highlights = ref(0);
        const shadows = ref(0);
        const saturation = ref(0);

        const dragging = ref(false);
        let panStart = null;
        let ditherTimer = null;
        let cropAnimation = null;
        let previewRevision = 0;
        let imageRevision = 0;

        /* é…è‰²åªè®°åœ¨æµè§ˆå™¨é‡Œï¼Œä¸å†™è®¾å¤‡ä¹Ÿä¸è¿›ä»»ä½•æ¥å£ã€‚ */
        const themes = [
          { id: 'paper', name: 'çº¸é¢', bg: '#e7e7e4', accent: '#1f4b78' },
          { id: 'mono', name: 'é»‘ç™½', bg: '#ffffff', accent: '#111111' },
          { id: 'graphite', name: 'çŸ³å¢¨', bg: '#17181a', accent: '#8fb8d8' },
          { id: 'amber', name: 'ç¥ç€', bg: '#16130d', accent: '#e8a33d' },
          { id: 'blueprint', name: 'è“å›¾', bg: '#0d1622', accent: '#4ea3e0' },
        ];
        const theme = ref('paper');
        const themeName = computed(() => (themes.find(t => t.id === theme.value) || themes[0]).name);
        const applyTheme = (id) => {
          const item = themes.find(t => t.id === id) || themes[0];
          const root = document.documentElement;
          if (root && root.setAttribute) root.setAttribute('data-theme', item.id);
          const meta = document.querySelector && document.querySelector('meta[name="theme-color"]');
          if (meta && meta.setAttribute) meta.setAttribute('content', item.bg);
        };
        const setTheme = (id) => {
          if (!themes.some(t => t.id === id)) return;
          theme.value = id;
          applyTheme(id);
          try { localStorage.setItem('eink.ui.theme.v1', id); } catch (_) {}
        };
        const restoreTheme = () => {
          let saved = '';
          try { saved = localStorage.getItem('eink.ui.theme.v1') || ''; } catch (_) {}
          if (!themes.some(t => t.id === saved)) {
            const media = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)');
            saved = media && media.matches ? 'graphite' : 'paper';
          }
          setTheme(saved);
        };

        const statusClass = computed(() => {
          if (phase.value === 'error') return 'err';
          if (phase.value === 'done') return 'ok';
          return '';
        });
        const busyLabel = computed(() => {
          if (!busy.value) return regionUpdate.value ? 'å‘é€åŒºåŸŸæ›¿æ¢ç”»é¢' : 'å‘é€åˆ°å±å¹•';
          return phase.value === 'prepare' ? 'ç”Ÿæˆç‚¹é˜µ' : 'å±å¹•åˆ·æ–°ä¸­';
        });

        const wrapLines = (ctx, content, maxWidth) => {
          const lines = [];
          for (const para of String(content || '').split(/\n/)) {
            if (!para) { lines.push(''); continue; }
            let line = '';
            for (const ch of para) {
              const trial = line + ch;
              if (ctx.measureText(trial).width > maxWidth && line) {
                lines.push(line);
                line = ch;
              } else line = trial;
            }
            lines.push(line);
          }
          return lines;
        };

        const rotatedSize = (img) => {
          const w = img.naturalWidth || img.width, h = img.naturalHeight || img.height;
          return imageRotation.value % 180 ? { w: h, h: w } : { w, h };
        };
        const rotateImage = (delta) => {
          if (busy.value || !imageEl.value) return;
          imageRotation.value = (imageRotation.value + delta + 360) % 360;
          resetCrop();
        };
        const cropRect = () => {
          const img = imageEl.value;
          if (!img) return null;
          const { w: iw, h: ih } = rotatedSize(img);
          const targetAspect = PANEL_W / PANEL_H;
          let baseW, baseH;
          if (iw / ih > targetAspect) {
            baseH = ih;
            baseW = ih * targetAspect;
          } else {
            baseW = iw;
            baseH = iw / targetAspect;
          }
          const sw = baseW / zoom.value;
          const sh = baseH / zoom.value;
          const maxX = Math.max(0, iw - sw);
          const maxY = Math.max(0, ih - sh);
          return {
            sx: panX.value * maxX,
            sy: panY.value * maxY,
            sw,
            sh,
          };
        };

        const renderText = () => {
          const el = canvas.value;
          if (!el) return;
          const ctx = el.getContext('2d', { willReadFrequently: true });
          ctx.fillStyle = cssOf(bg.value);
          ctx.fillRect(0, 0, PANEL_W, PANEL_H);
          ctx.fillStyle = cssOf(fg.value);
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.font = `600 ${fontSize.value}px "Songti SC","Noto Serif SC","PingFang SC","Microsoft YaHei",serif`;
          const lines = wrapLines(ctx, text.value, PANEL_W - 56);
          const lineH = fontSize.value * 1.25;
          let y = (PANEL_H - lines.length * lineH) / 2 + lineH / 2;
          for (const line of lines) {
            ctx.fillText(line, PANEL_W / 2, y);
            y += lineH;
